      "comment": "Session phase: active",
      "extractionState": "manual"
    },
    "Adults wear the sensor on the belly. Children aged 2 to 17 can use the belly or upper buttocks.": {
      "comment": "Apply-sensor site instruction",
      "extractionState": "manual"
    },
    "After warm-up": {
      "comment": "Why calibration is unavailable during warm-up",
      "extractionState": "manual"
    },
